# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Generate a strong random secret (at least 32 characters); keep the real value only in .env.local/Vercel.
APP_SECRET=

# Optional: set the canonical public URL when generating public album links later.
NEXT_PUBLIC_APP_URL=http://localhost:3000
